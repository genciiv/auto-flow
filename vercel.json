{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "fra1"
  ],
  "functions": {
    "src/app/api/health/ready/route.js": {
      "maxDuration": 10
    },
    "src/app/api/health/live/route.js": {
      "maxDuration": 10
    },
    "src/app/api/cron/subscriptions/route.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/subscriptions",
      "schedule": "15 1 * * *"
    }
  ]
}
