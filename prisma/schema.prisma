generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | Global user roles
 * |--------------------------------------------------------------------------
 * |
 * | PLATFORM_ADMIN:
 * | Pronari ose administratori i platformës AutoFlow.
 * |
 * | CUSTOMER:
 * | Klienti final që përdor portalin e klientit.
 * |
 * | OWNER, MANAGER, MECHANIC etj. nuk vendosen këtu.
 * | Ato vendosen te BusinessUser, sepse një përdorues mund të ketë role
 * | të ndryshme në biznese të ndryshme.
 * |
 */

enum UserRole {
  PLATFORM_ADMIN
  CUSTOMER
}

/**
 * |--------------------------------------------------------------------------
 * | Business roles
 * |--------------------------------------------------------------------------
 * |
 * | Këto janë rolet e përdoruesve brenda një servisi specifik.
 * |
 */

enum BusinessRole {
  OWNER
  MANAGER
  MECHANIC
  RECEPTIONIST
  WAREHOUSE
  ACCOUNTANT
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServiceStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  WAITING_FOR_PARTS
  READY_FOR_PICKUP
  COMPLETED
  DELIVERED
  CANCELLED
}

enum MaintenanceType {
  ENGINE_OIL
  OIL_FILTER
  AIR_FILTER
  CABIN_FILTER
  FUEL_FILTER
  BRAKE_FLUID
  COOLANT
  TIMING_BELT
  GEARBOX_OIL
  BRAKES
  BATTERY
  TIRES
  SPARK_PLUGS
  OTHER
}

enum MaintenanceStatus {
  OK
  SOON
  OVERDUE
}

enum VehicleHistorySource {
  CUSTOMER
  SERVICE
  SYSTEM
}

enum CustomerVehicleExpenseType {
  FUEL
  INSURANCE
  TAX
  TIRES
  PARKING
  WASH
  REPAIR
  PARTS
  TOLL
  OTHER
}

enum CustomerVehicleReminderType {
  INSURANCE
  TECHNICAL_INSPECTION
  ROAD_TAX
  CUSTOM
}

enum CustomerVehicleDocumentType {
  INSURANCE
  TECHNICAL_INSPECTION
  ROAD_TAX
  REGISTRATION_CERTIFICATE
  OWNERSHIP
  OTHER
}

enum ServiceLineType {
  LABOR
  PART
}

enum InventoryMovementType {
  SERVICE_OUT
  SERVICE_RETURN
  PURCHASE_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InventoryCountStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  POSTED
  CANCELLED
}

enum FinancialPeriodType {
  MONTHLY
  QUARTERLY
  SIX_MONTHS
  YEARLY
  CUSTOM
}

enum FinancialReportType {
  SUMMARY
  INCOME_EXPENSES
  INVENTORY
  RECEIVABLES
  FULL
}

enum InvoiceStatus {
  DRAFT
  PAID
  UNPAID
  OVERDUE
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationEntity {
  SERVICE
  VEHICLE
  APPOINTMENT
  CUSTOMER
  BUSINESS
  PAYMENT
  SUBSCRIPTION
  DOCUMENT
  SYSTEM
  CHAT
}

enum VehicleClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ChatSenderType {
  BUSINESS
  CUSTOMER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  PAYMENT
  CUSTOM
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_ACTIVATION
  EMAIL_CHANGE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionPlanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  PAYPAL
  OTHER
}

/**
 * |--------------------------------------------------------------------------
 * | User
 * |--------------------------------------------------------------------------
 */

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String?
  globalRole          UserRole?
  isActive            Boolean   @default(true)
  emailVerified       DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  sessionVersion      Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  businesses BusinessUser[]

  customerProfile CustomerProfile?

  notifications                    Notification[]
  auditLogs                        AuditLog[]
  authTokens                       AuthToken[]
  staffInvitationsSent             StaffInvitation[]         @relation("StaffInvitationInviter")
  subscriptionPlanRequestsCreated  SubscriptionPlanRequest[] @relation("SubscriptionPlanRequestRequester")
  subscriptionPlanRequestsReviewed SubscriptionPlanRequest[] @relation("SubscriptionPlanRequestReviewer")
  assignedServices                 ServiceRecord[]           @relation("ServiceAssignedUser")
  serviceStatusChanges             ServiceStatusHistory[]    @relation("ServiceStatusChangedBy")
  serviceLaborItemsCreated         ServiceLaborItem[]        @relation("ServiceLaborItemCreator")
  inventoryMovements               InventoryMovement[]       @relation("InventoryMovementUser")
  customerPaymentsRecorded         CustomerPayment[]         @relation("CustomerPaymentRecorder")
  assignedAppointments             Appointment[]             @relation("AppointmentAssignedUser")
  chatMessagesSent                 ChatMessage[]              @relation("ChatMessageSender")

  @@index([email])
  @@index([phone])
  @@index([globalRole])
  @@index([isActive])
  @@index([lockedUntil])
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique

  firstName String?
  lastName  String?

  phone   String?
  city    String?
  address String?

  birthDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicles      CustomerVehicle[]
  conversations Conversation[]

  @@index([userId])
}

/**
 * |--------------------------------------------------------------------------
 * | Business
 * |--------------------------------------------------------------------------
 */

model Business {
  id           String   @id @default(cuid())
  name         String
  nipt         String?  @unique
  city         String?
  address      String?
  phone        String?
  email        String?
  website      String?
  logo         String?
  workingHours String?
  currency     String   @default("ALL")
  vat          Decimal  @default(20) @db.Decimal(5, 2)
  timezone     String   @default("Europe/Tirane")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                    BusinessUser[]
  customers                Customer[]
  vehicles                 Vehicle[]
  services                 ServiceRecord[]
  appointments             Appointment[]
  parts                    Part[]
  invoices                 Invoice[]
  purchaseOrders           PurchaseOrder[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  subscriptions            Subscription[]
  payments                 Payment[]
  staffInvitations         StaffInvitation[]
  subscriptionPlanRequests SubscriptionPlanRequest[]
  inventoryMovements       InventoryMovement[]
  customerPayments         CustomerPayment[]
  expenseCategories        ExpenseCategory[]
  businessExpenses         BusinessExpense[]
  inventoryCounts          InventoryCount[]
  financialReportExports   FinancialReportExport[]
  conversations            Conversation[]

  @@index([name])
  @@index([city])
  @@index([email])
  @@index([phone])
  @@index([isActive])
}

/**
 * |--------------------------------------------------------------------------
 * | BusinessUser
 * |--------------------------------------------------------------------------
 * |
 * | Lidh një përdorues me një biznes.
 * |
 * | Shembull:
 * | owner@autoflow.al
 * | OWNER
 * | Auto Service Fier
 * |
 */

model BusinessUser {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(OWNER)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([businessId, role])
  @@index([businessId, isActive])
}

/**
 * |--------------------------------------------------------------------------
 * | Customer
 * |--------------------------------------------------------------------------
 */

model StaffInvitation {
  id          String                @id @default(cuid())
  businessId  String
  invitedById String
  email       String
  role        BusinessRole
  tokenHash   String                @unique
  status      StaffInvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("StaffInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  city       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  invoices     Invoice[]
  appointments Appointment[]

  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, phone])
  @@index([businessId, email])
}

/**
 * |--------------------------------------------------------------------------
 * | Vehicle
 * |--------------------------------------------------------------------------
 */

model Vehicle {
  id         String   @id @default(cuid())
  businessId String
  customerId String?
  plate      String
  brand      String
  model      String?
  year       Int?
  vin        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  services         ServiceRecord[]
  appointments     Appointment[]
  invoices         Invoice[]
  portalClaims     VehicleClaim[]
  customerLinks    CustomerVehicleLink[]
  maintenanceItems MaintenanceItem[]
  conversations    Conversation[]

  @@unique([businessId, plate])
  @@index([businessId])
  @@index([customerId])
  @@index([businessId, brand])
  @@index([businessId, vin])
}

model CustomerVehicle {
  id String @id @default(cuid())

  profileId String

  plate String

  brand String
  model String?

  year Int?

  fuel String?

  engine String?

  transmission String?

  vin String?

  mileage Int?

  color String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  claims             VehicleClaim[]
  links              CustomerVehicleLink[]
  mileageHistory     CustomerVehicleMileage[]
  expenses           CustomerVehicleExpense[]
  maintenanceHistory CustomerVehicleMaintenance[]
  reminders          CustomerVehicleReminder[]
  documents          CustomerVehicleDocument[]

  @@unique([profileId, plate])
  @@index([profileId])
  @@index([plate])
  @@index([brand])
  @@index([vin])
}

model CustomerVehicleMileage {
  id String @id @default(cuid())

  customerVehicleId String
  mileage           Int
  recordedAt        DateTime
  source            VehicleHistorySource @default(CUSTOMER)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerVehicle CustomerVehicle @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)

  @@index([customerVehicleId, recordedAt])
  @@index([customerVehicleId, mileage])
  @@index([source])
}

model CustomerVehicleExpense {
  id String @id @default(cuid())

  customerVehicleId String
  type              CustomerVehicleExpenseType
  amount            Decimal @db.Decimal(18, 2)
  currency          String  @default("ALL")
  occurredAt        DateTime
  mileage           Int?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerVehicle CustomerVehicle @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)

  @@index([customerVehicleId, occurredAt])
  @@index([customerVehicleId, type])
}

model CustomerVehicleMaintenance {
  id String @id @default(cuid())

  customerVehicleId String
  type              MaintenanceType
  title             String
  performedAt       DateTime
  mileage           Int?
  intervalKm        Int?
  nextMileage       Int?
  intervalMonths    Int?
  nextDate          DateTime?
  source            VehicleHistorySource @default(CUSTOMER)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerVehicle CustomerVehicle @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)

  @@index([customerVehicleId, performedAt])
  @@index([customerVehicleId, type, performedAt])
  @@index([nextDate])
  @@index([nextMileage])
  @@index([source])
}

model CustomerVehicleDocument {
  id String @id @default(cuid())

  customerVehicleId String
  type              CustomerVehicleDocumentType
  title             String
  fileName          String
  storagePath       String @unique
  mimeType          String
  sizeBytes         Int
  issuedAt          DateTime?
  expiresAt         DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerVehicle CustomerVehicle          @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)
  reminder        CustomerVehicleReminder?

  @@index([customerVehicleId, createdAt])
  @@index([customerVehicleId, type])
  @@index([expiresAt])
}

model CustomerVehicleReminder {
  id String @id @default(cuid())

  customerVehicleId String
  documentId        String? @unique
  type              CustomerVehicleReminderType
  title             String
  dueDate           DateTime?
  dueMileage        Int?
  remindDaysBefore  Int @default(30)
  notificationSentAt DateTime?
  isActive          Boolean @default(true)
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerVehicle CustomerVehicle          @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)
  document        CustomerVehicleDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([customerVehicleId, isActive])
  @@index([customerVehicleId, type, isActive])
  @@index([dueDate, isActive, notificationSentAt])
  @@index([dueMileage])
}

model VehicleClaim {
  id String @id @default(cuid())

  customerVehicleId String
  vehicleId         String

  status VehicleClaimStatus @default(PENDING)

  customerMessage String?
  rejectionReason String?

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerVehicle CustomerVehicle @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([customerVehicleId, vehicleId])
  @@index([customerVehicleId])
  @@index([vehicleId])
  @@index([status])
  @@index([vehicleId, status])
}

model CustomerVehicleLink {
  id String @id @default(cuid())

  customerVehicleId String
  vehicleId         String

  isActive Boolean @default(true)

  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?

  customerVehicle CustomerVehicle @relation(fields: [customerVehicleId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([customerVehicleId, vehicleId])
  @@index([customerVehicleId])
  @@index([vehicleId])
  @@index([isActive])
  @@index([customerVehicleId, isActive])
  @@index([vehicleId, isActive])
}

model MaintenanceItem {
  id String @id @default(cuid())

  vehicleId       String
  serviceRecordId String?

  type   MaintenanceType
  title  String
  status MaintenanceStatus @default(OK)

  lastMileage Int?
  nextMileage Int?
  intervalKm  Int?

  lastDate DateTime?
  nextDate DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceRecord ServiceRecord? @relation(fields: [serviceRecordId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([serviceRecordId])
  @@index([type])
  @@index([status])
  @@index([vehicleId, status])
  @@index([vehicleId, type])
}

/**
 * |--------------------------------------------------------------------------
 * | ServiceRecord
 * |--------------------------------------------------------------------------
 */

model ServiceRecord {
  id                       String        @id @default(cuid())
  businessId               String
  vehicleId                String
  customerId               String?
  assignedUserId           String?
  title                    String
  description              String?
  diagnosis                String?
  internalNotes            String?
  customerApprovalRequired Boolean       @default(false)
  customerApprovedAt       DateTime?
  status                   ServiceStatus @default(PENDING)
  total                    Decimal       @default(0) @db.Decimal(18, 2)
  startedAt                DateTime?
  readyAt                  DateTime?
  completedAt              DateTime?
  deliveredAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedUser User?    @relation("ServiceAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  invoice            Invoice?
  partsUsed          ServicePartUsage[]
  conversations Conversation[]
  maintenanceItems   MaintenanceItem[]
  statusHistory      ServiceStatusHistory[]
  laborItems         ServiceLaborItem[]
  inventoryMovements InventoryMovement[]
  appointment        Appointment?           @relation("AppointmentService")

  @@index([businessId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([assignedUserId])
}

model ServiceStatusHistory {
  id          String         @id @default(cuid())
  serviceId   String
  changedById String?
  fromStatus  ServiceStatus?
  toStatus    ServiceStatus
  note        String?
  createdAt   DateTime       @default(now())

  service   ServiceRecord @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  changedBy User?         @relation("ServiceStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
  @@index([changedById])
}

/**
 * |--------------------------------------------------------------------------
 * | Appointment
 * |--------------------------------------------------------------------------
 */

model Appointment {
  id                  String            @id @default(cuid())
  businessId          String
  vehicleId           String?
  customerId          String?
  assignedUserId      String?
  serviceId           String?           @unique
  title               String
  description         String?
  date                DateTime
  durationMinutes     Int               @default(60)
  status              AppointmentStatus @default(PENDING)
  customerConfirmedAt DateTime?
  reminderSentAt      DateTime?
  cancellationReason  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User?          @relation("AppointmentAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  service      ServiceRecord? @relation("AppointmentService", fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([businessId, date])
  @@index([businessId, status])
  @@index([businessId, assignedUserId, date])
}

/**
 * |--------------------------------------------------------------------------
 * | Part
 * |--------------------------------------------------------------------------
 */

model Part {
  id         String   @id @default(cuid())
  businessId String
  code       String?
  name       String
  category   String?
  supplier   String?
  stock      Int      @default(0)
  minStock   Int      @default(0)
  buyPrice   Decimal  @default(0) @db.Decimal(18, 2)
  sellPrice  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceUsages      ServicePartUsage[]
  inventoryMovements InventoryMovement[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, category])
  @@index([businessId, stock])
}

/**
 * |--------------------------------------------------------------------------
 * | PurchaseOrder
 * |--------------------------------------------------------------------------
 */

model PurchaseOrder {
  id         String         @id @default(cuid())
  businessId String
  supplier   String
  status     PurchaseStatus @default(PENDING)
  total      Decimal        @default(0) @db.Decimal(18, 2)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, supplier])
}

/**
 * |--------------------------------------------------------------------------
 * | PurchaseOrderItem
 * |--------------------------------------------------------------------------
 */

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  name            String
  quantity        Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(18, 2)
  total           Decimal @default(0) @db.Decimal(18, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

/**
 * |--------------------------------------------------------------------------
 * | ServicePartUsage
 * |--------------------------------------------------------------------------
 */

model ServicePartUsage {
  id        String   @id @default(cuid())
  serviceId String
  partId    String
  quantity  Int      @default(1)
  unitPrice Decimal  @default(0) @db.Decimal(18, 2)
  total     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  service ServiceRecord @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  part    Part          @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([serviceId, partId])
  @@index([serviceId])
  @@index([partId])
}

model ServiceLaborItem {
  id          String   @id @default(cuid())
  serviceId   String
  createdById String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  total       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service   ServiceRecord @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("ServiceLaborItemCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([createdById])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  businessId  String
  partId      String
  serviceId   String?
  userId      String?
  type        InventoryMovementType
  quantity    Int
  stockBefore Int
  stockAfter  Int
  note        String?
  createdAt   DateTime              @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  part     Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  service  ServiceRecord? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user     User?          @relation("InventoryMovementUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([partId, createdAt])
  @@index([serviceId])
  @@index([userId])
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  type        ServiceLineType
  description String
  quantity    Decimal         @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal         @default(0) @db.Decimal(18, 2)
  total       Decimal         @default(0) @db.Decimal(18, 2)
  createdAt   DateTime        @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CustomerPayment {
  id           String        @id @default(cuid())
  businessId   String
  invoiceId    String
  recordedById String?
  amount       Decimal       @db.Decimal(18, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  notes        String?
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("CustomerPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([businessId, paidAt])
  @@index([invoiceId, paidAt])
  @@index([recordedById])
}

/**
 * |--------------------------------------------------------------------------
 * | Invoice
 * |--------------------------------------------------------------------------
 */

model Invoice {
  id         String        @id @default(cuid())
  businessId String
  customerId String?
  vehicleId  String?
  serviceId  String?       @unique
  number     String
  status     InvoiceStatus @default(DRAFT)
  total      Decimal       @default(0) @db.Decimal(18, 2)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  service          ServiceRecord?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  customerPayments CustomerPayment[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model ExpenseCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses BusinessExpense[]

  @@unique([businessId, name])
  @@index([businessId, isActive])
}

model BusinessExpense {
  id             String        @id @default(cuid())
  businessId     String
  categoryId     String?
  recordedById   String?
  status         ExpenseStatus @default(POSTED)
  description    String
  supplier       String?
  documentNumber String?
  amount         Decimal       @db.Decimal(18, 2)
  paymentMethod  PaymentMethod @default(CASH)
  expenseDate    DateTime
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([businessId, expenseDate])
  @@index([businessId, status])
  @@index([categoryId])
  @@index([recordedById])
}

model InventoryCount {
  id           String               @id @default(cuid())
  businessId   String
  createdById  String?
  approvedById String?
  name         String
  periodType   FinancialPeriodType  @default(MONTHLY)
  status       InventoryCountStatus @default(DRAFT)
  countDate    DateTime
  notes        String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  postedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    InventoryCountItem[]

  @@index([businessId, countDate])
  @@index([businessId, status])
  @@index([createdById])
}

model InventoryCountItem {
  id               String   @id @default(cuid())
  inventoryCountId String
  partId           String
  partName         String
  partCode         String?
  expectedQuantity Int
  actualQuantity   Int?
  difference       Int?
  unitCost         Decimal  @default(0) @db.Decimal(18, 2)
  expectedValue    Decimal  @default(0) @db.Decimal(18, 2)
  actualValue      Decimal? @db.Decimal(18, 2)
  differenceValue  Decimal? @db.Decimal(18, 2)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)

  @@unique([inventoryCountId, partId])
  @@index([inventoryCountId])
  @@index([partId])
}

model FinancialReportExport {
  id          String              @id @default(cuid())
  businessId  String
  userId      String?
  reportType  FinancialReportType
  periodStart DateTime
  periodEnd   DateTime
  format      String              @default("XLSX")
  fileName    String
  createdAt   DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, reportType])
  @@index([userId])
}

model BusinessApplication {
  id                 String            @id @default(cuid())
  businessName       String
  ownerName          String
  email              String
  phone              String
  city               String
  address            String?
  notes              String?
  status             ApplicationStatus @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?
  reviewedById       String?
  approvedBusinessId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([email])
  @@index([city])
  @@index([createdAt])
}

model Plan {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  monthlyPrice Float @default(0)
  yearlyPrice  Float @default(0)

  maxUsers     Int?
  maxCustomers Int?
  maxVehicles  Int?

  features Json?

  isActive      Boolean @default(true)
  isRecommended Boolean @default(false)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions            Subscription[]
  subscriptionPlanRequests SubscriptionPlanRequest[]

  @@index([name])
  @@index([isActive])
  @@index([isRecommended])
  @@index([sortOrder])
}

model Subscription {
  id         String @id @default(cuid())
  businessId String
  planId     String

  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval    @default(MONTHLY)

  price Float @default(0)

  trialStartsAt DateTime?
  trialEndsAt   DateTime?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelledAt       DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments     Payment[]
  planRequests SubscriptionPlanRequest[]

  @@index([businessId])
  @@index([planId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([currentPeriodEnd])
  @@index([businessId, status])
}

model SubscriptionPlanRequest {
  id              String  @id @default(cuid())
  businessId      String
  requestedPlanId String
  requestedById   String
  reviewedById    String?
  subscriptionId  String?

  status          SubscriptionPlanRequestStatus @default(PENDING)
  billingInterval BillingInterval               @default(MONTHLY)
  requestedPrice  Float
  currentPlanName String?
  notes           String?
  rejectionReason String?

  reviewedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedPlan Plan          @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)
  requestedBy   User          @relation("SubscriptionPlanRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("SubscriptionPlanRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([requestedPlanId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([subscriptionId])
  @@index([status, createdAt])
}

model Payment {
  id             String  @id @default(cuid())
  businessId     String
  subscriptionId String?

  amount   Float
  currency String @default("ALL")

  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(OTHER)

  reference   String?
  description String?
  paidAt      DateTime?

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
  @@index([businessId, status])
}


model Conversation {
  id                String             @id @default(cuid())
  businessId        String
  customerProfileId String
  vehicleId         String
  serviceId         String?
  subject           String?
  status            ConversationStatus @default(ACTIVE)
  businessLastReadAt DateTime?
  customerLastReadAt DateTime?
  lastMessageAt      DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  service         ServiceRecord?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  messages        ChatMessage[]

  @@index([businessId, status, lastMessageAt])
  @@index([customerProfileId, status, lastMessageAt])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  senderUserId   String
  senderType     ChatSenderType
  body           String         @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([senderType])
}

model Notification {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  title   String
  message String

  type NotificationType

  entityType NotificationEntity?
  entityId   String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([businessId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  businessId String?
  userId     String?

  action     AuditAction
  entityType String
  entityId   String?

  title       String
  description String?

  oldValues Json?
  newValues Json?
  metadata  Json?

  createdAt DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([userId, createdAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@index([userId, type])
  @@index([userId, type, usedAt])
}

model RateLimitBucket {
  id           String    @id @default(cuid())
  keyHash      String    @unique
  scope        String
  count        Int       @default(0)
  windowStart  DateTime
  expiresAt    DateTime
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scope, expiresAt])
  @@index([blockedUntil])
}

model PlatformSetting {
  id String @id @default(cuid())

  platformName    String  @default("AutoFlow")
  supportEmail    String?
  supportPhone    String?
  companyAddress  String?
  defaultCurrency String  @default("ALL")
  defaultTimezone String  @default("Europe/Tirane")

  trialEnabled      Boolean @default(true)
  trialDurationDays Int     @default(7)

  cashPaymentsEnabled Boolean @default(true)
  bankPaymentsEnabled Boolean @default(true)
  cardPaymentsEnabled Boolean @default(false)

  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIban          String?
  bankSwiftCode     String?

  maintenanceMode    Boolean @default(false)
  allowRegistrations Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
