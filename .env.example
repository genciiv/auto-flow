# Runtime
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

# Observability
LOG_LEVEL=debug
OTEL_SERVICE_NAME=autoflow-web
APP_VERSION=local
# Enable only for temporary database debugging; query logs can be noisy.
PRISMA_LOG_QUERIES=false

# Email
BREVO_API_KEY=xkeysib-xxxxxxxxx
EMAIL_FROM=AutoFlow <no-reply@example.com>
EMAIL_REPLY_TO=support@example.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=autoflow

# Production safeguards
ENABLE_TEST_EMAIL_API=false

# Secret used by scheduled maintenance endpoints (minimum 32 random characters)
CRON_SECRET="replace-with-a-long-random-secret"
