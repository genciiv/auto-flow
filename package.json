    "test:contracts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/support/register.mjs --test --test-reporter=spec tests/contracts/index.test.mjs",
    "audit:tests": "node scripts/audit-automated-testing.mjs",
    "audit:database": "node scripts/audit-database-safety.mjs",
    "db:target": "node scripts/db/show-target.mjs",
    "db:baseline:generate": "node scripts/db/generate-baseline.mjs",
    "db:baseline:resolve": "node scripts/db/resolve-baseline.mjs",
    "db:drift:check": "node scripts/db/check-drift.mjs",
